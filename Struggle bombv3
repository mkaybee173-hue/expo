import React, { useEffect, useState, useRef } from 'react';
import { View, Text, ScrollView, StyleSheet } from 'react-native';

const SYMBOLS = [
  { id: 'XAUUSD', label: 'GOLD', type: 'binance', bin: 'PAXGUSDT', sl: 2.5, tp: 11.25 },
  { id: 'EURUSD', label: 'EURUSD', type: 'binance', bin: 'EURUSDT', sl: 0.0010, tp: 0.0045 },
  { id: 'GBPUSD', label: 'GBPUSD', type: 'binance', bin: 'GBPUSDT', sl: 0.0015, tp: 0.0067 },
  { id: 'USDJPY', label: 'USDJPY', type: 'forex', from: 'USD', key: 'JPY', sl: 0.12, tp: 0.54 },
  { id: 'AUDUSD', label: 'AUDUSD', type: 'forex', from: 'AUD', key: 'USD', sl: 0.0010, tp: 0.0045 },
  { id: 'US30', label: 'US30', type: 'index', yahoo: '%5EDJI', sl: 35, tp: 157 },
  { id: 'NAS100', label: 'NASDAQ', type: 'index', yahoo: '%5EIXIC', sl: 30, tp: 135 },
  { id: 'BTCUSD', label: 'BTC', type: 'binance', bin: 'BTCUSDT', sl: 120, tp: 540 },
];

async function getPrice(s){
 try{
  if(s.type==='binance'){
    const r=await fetch('https://api.binance.com/api/v3/ticker/price?symbol='+s.bin);
    const d=await r.json();
    return parseFloat(d.price);
  }
  if(s.type==='forex'){
    const r=await fetch('https://open.er-api.com/v6/latest/'+s.from);
    const d=await r.json();
    return parseFloat(d.rates[s.key]);
  }
  if(s.type==='index'){
    const t='https://query1.finance.yahoo.com/v8/finance/chart/'+s.yahoo+'?interval=1m';
    const r=await fetch('https://corsproxy.io/?'+encodeURIComponent(t));
    const d=await r.json();
    return d.chart.result[0].meta.regularMarketPrice;
  }
 }catch{ return null; }
}

function getRSI(arr){
  if(arr.length<14) return 50;
  let g=0,l=0;
  for(let i=arr.length-14;i<arr.length-1;i++){
    let diff=arr[i+1]-arr[i];
    if(diff>0) g+=diff; else l+=-diff;
  }
  if(l===0) return 70;
  return 100-(100/(1+g/l));
}

function getTime(){
  const now=new Date();
  return now.toLocaleTimeString('en-ZA',{hour:'2-digit',minute:'2-digit',second:'2-digit', hour12:false, timeZone:'Africa/Johannesburg'}) + ' SAST';
}

export default function App(){
  const [prices,setPrices]=useState({});
  const [sigs,setSigs]=useState([]);
  const ref=useRef({});
  const lastSig=useRef({});
  const [candles,setCandles]=useState({});

  useEffect(()=>{
    SYMBOLS.forEach(s=>{ ref.current[s.id]=[]; lastSig.current[s.id]=0; });
    const loop=async()=>{
      let np={};
      for(let s of SYMBOLS){
        const p=await getPrice(s);
        if(!p) continue;
        np[s.id]=p;
        let a=ref.current[s.id];
        a.push(p);
        if(a.length>60) a.shift();
        if(a.length>=55){
          const last=a[a.length-1];
          const prev=a[a.length-2];
          const ma50=a.reduce((x,y)=>x+y,0)/a.length;
          const rsi=getRSI(a);
          const range=Math.max(...a.slice(-20))-Math.min(...a.slice(-20));
          const isChop = false; // DISABLE chop filter - let everything through for testing
const rsiOk = true; // DISABLE RSI filter;
          const trendBuy = last > ma50;
          const trendSell = last < ma50;
          const recentHigh=Math.max(...a.slice(-25,-1));
          const recentLow=Math.min(...a.slice(-25,-1));
          let sweepHigh=false;
          let sweepLow=false;
          if(prev >= recentHigh*0.999){
            if(last < recentHigh*0.999) sweepHigh=true;
          }
          if(prev <= recentLow*1.001){
            if(last > recentLow*1.001) sweepLow=true;
          }
          const now=Date.now();
          const cool=10*60*1000;
          if(now - lastSig.current[s.id] < cool) continue;
          if(!isChop && rsiOk){
            if(sweepLow && trendBuy){
              const txt='['+getTime()+'] BUY '+s.label+' @ '+last.toFixed(2)+' SL '+(last-s.sl).toFixed(2)+' TP '+(last+s.tp).toFixed(2)+' RSI '+rsi.toFixed(0);
              setSigs(v=>[txt,...v.slice(0,9)]);
              lastSig.current[s.id]=now;
            }
            if(sweepHigh && trendSell){
              const txt='['+getTime()+'] SELL '+s.label+' @ '+last.toFixed(2)+' SL '+(last+s.sl).toFixed(2)+' TP '+(last-s.tp).toFixed(2)+' RSI '+rsi.toFixed(0);
              setSigs(v=>[txt,...v.slice(0,9)]);
              lastSig.current[s.id]=now;
            }
          }
        }
      }
      setPrices(p=>({...p,...np}));
      setCandles({...ref.current});
    };
    loop();
    const id=setInterval(loop,5000);
    return()=>clearInterval(id);
  },[]);

  return(
    <ScrollView style={styles.c}>
      <Text style={styles.t}>💣 STRUGGLE BOMBER V3 💣</Text>
      <Text style={styles.sub}>NO ERROR | BALANCED | 10 MIN LOCK | RR 1:4.5</Text>
      <View style={styles.grid}>
        {SYMBOLS.map(s=>
          <View key={s.id} style={styles.card}>
            <Text style={styles.l}>{s.label}</Text>
            <Text style={styles.p}>{prices[s.id]?prices[s.id].toFixed(2):'---'}</Text>
            <Text style={styles.cc}>{(candles[s.id]?.length||0)}/60</Text>
          </View>
        )}
      </View>
      <Text style={styles.st}>A+ SIGNALS WITH TIME</Text>
      {sigs.length===0? <Text style={styles.wait}>Waiting... 60/60 ready, balanced filters active ✅</Text>:null}
      {sigs.map((x,i)=><View key={i} style={styles.sig}><Text style={styles.sigt}>{x}</Text></View>)}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  c:{flex:1,backgroundColor:'#0a0a0a',padding:12,paddingTop:36},
  t:{color:'#00ff88',fontWeight:'bold',fontSize:14,textAlign:'center'},
  sub:{color:'#ffcc00',fontSize:8,textAlign:'center',marginVertical:6},
  grid:{flexDirection:'row',flexWrap:'wrap',justifyContent:'space-between'},
  card:{width:'23%',backgroundColor:'#1c1c1e',borderRadius:10,padding:7,marginBottom:8,borderWidth:1,borderColor:'#00ff88',alignItems:'center'},
  l:{color:'#fff',fontSize:9,fontWeight:'bold'},
  p:{color:'#ffcc00',fontSize:9,marginTop:2},
  cc:{color:'#666',fontSize:7},
  st:{color:'#00ff88',fontWeight:'bold',marginTop:12,fontSize:11},
  wait:{color:'#888',fontSize:10,marginTop:5},
  sig:{backgroundColor:'#1c1c1e',borderLeftWidth:3,borderLeftColor:'#00ff88',padding:10,marginTop:8,borderRadius:6},
  sigt:{color:'#fff',fontSize:11}
});
